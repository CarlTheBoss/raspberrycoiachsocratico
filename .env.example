# ==========================================
# 🔑 API KEYS REQUERIDAS
# ==========================================

# 1. Google Gemini (Para el tutor socrático) - https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 2. Fish Audio API (Para la Voz S2.1 Pro TTS) - https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=tu_fish_audio_api_key_aqui

# 3. Groq API (Para transcripción de voz rápida y gratis) - https://console.groq.com/
GROQ_API_KEY=tu_groq_api_key_aqui

# ==========================================
# ⚙️ CONFIGURACIÓN DE VOZ (Fish Audio)
# ==========================================
FISH_TTS_MODEL=s2.1-pro-free
# (Opcional) ID de la voz fija de Fish Audio (ej. de https://fish.audio/discovery):
FISH_REFERENCE_ID=

# ==========================================
# 🎙️ SENSIBILIDAD DEL MICRÓFONO E INTERRUPCIÓN
# ==========================================
# Tiempo de pausa para detectar que el niño terminó de hablar (segundos)
SILENCE_DURATION=1.8

# Sensibilidad para empezar a escuchar al niño
ENERGY_THRESHOLD=0.015

# Sensibilidad para interrumpir al robot mientras habla (Barge-in)
INTERRUPT_THRESHOLD=0.025

# Pin GPIO de Raspberry Pi para botón físico (Opcional, e.g. 17)
GPIO_BUTTON_PIN=
