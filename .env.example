# ==========================================
# 🔑 API KEYS REQUERIDAS
# ==========================================

# 1. Google Gemini (Para el tutor socrático y STT Gemini) - https://aistudio.google.com/
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Proveedor de Reconocimiento de Voz (STT): 'deepgram', 'gemini' o 'groq'
# Recomendado: 'deepgram' (Nova-3 ultra-rápido en ~150ms) o 'gemini'
STT_PROVIDER=deepgram

# 2. Deepgram API (Recomendado para STT Nova-3) - https://console.deepgram.com/
DEEPGRAM_API_KEY=tu_deepgram_api_key_aqui

# 3. Groq API (Fallback o STT Whisper gratuito) - https://console.groq.com/
GROQ_API_KEY=tu_groq_api_key_aqui

# 4. Fish Audio API (Para la Voz TTS S2.1 Pro) - https://fish.audio/app/api-keys/
FISH_AUDIO_API_KEY=tu_fish_audio_api_key_aqui

# ==========================================
# ⚙️ CONFIGURACIÓN DE VOZ (Fish Audio TTS)
# ==========================================
FISH_TTS_MODEL=s2.1-pro-free
# (Opcional) ID de la voz fija/clonada de Fish Audio (ej. de https://fish.audio/discovery):
FISH_REFERENCE_ID=

# ==========================================
# 🎙️ SENSIBILIDAD DEL MICRÓFONO Y PUSH-TO-TALK
# ==========================================
# SILENCE_DURATION: Tiempo de pausa en modo manos libres para detectar fin de turno (segundos)
SILENCE_DURATION=1.6

# Umbral de energía para detección de voz en silencio
ENERGY_THRESHOLD=0.0060

# Umbral para interrupción selectiva mientras el robot habla
INTERRUPT_THRESHOLD=0.025

# Pin GPIO de Raspberry Pi para botón arcade físico (ej. 17). Deja vacío para modo PC o manos libres
GPIO_BUTTON_PIN=

# Tecla para simular botón en PC con Push-to-Talk (ej: 'space'). Deja vacío para desactivar simulación
SIMULATE_BUTTON_KEY=space
